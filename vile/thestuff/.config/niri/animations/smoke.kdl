animations {
    window-open {
        duration-ms 500
        curve "cubic-bezier" 0.42 0.0 1.0 1.0
        custom-shader r"
            float hash21(vec2 p) {
                return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
            }

            float value_noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                vec2 u = f * f * (3.0 - 2.0 * f);
                return mix(
                    mix(hash21(i), hash21(i + vec2(1.0, 0.0)), u.x),
                    mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), u.x),
                    u.y
                );
            }

            float fbm(vec2 p) {
                float v = 0.0;
                float amp = 0.5;
                float freq = 1.0;
                for (int i = 0; i < 5; i++) {
                    v += amp * value_noise(p * freq);
                    freq *= 2.0;
                    amp *= 0.5;
                }
                return v;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = coords_geo.xy;
                float p = 1.0 - niri_clamped_progress;
                float seed = niri_random_seed * 100.0;
                float min_dim = min(size_geo.x, size_geo.y);

                float dx = min(uv.x, 1.0 - uv.x) * size_geo.x;
                float dy = min(uv.y, 1.0 - uv.y) * size_geo.y;
                float edge_dist = min(dx, dy);

                // Use absolute pixel dimensions to keep noise visually identical on all window sizes
                vec2 noise_coords = uv * size_geo.xy / 150.0 + seed;
                float edge_noise = fbm(noise_coords * 1.5);
                float erode = p * 0.80;
                float edge_threshold = edge_noise * erode * min_dim;
                float edge_softness = min_dim * 0.02;
                float edge_alpha = smoothstep(edge_threshold - edge_softness, edge_threshold + edge_softness, edge_dist);

                if (edge_dist < -min_dim * 0.15) {
                    return vec4(0.0);
                }

                float wx = fbm(noise_coords + vec2(17.3, 0.0)) - 0.5;
                float wy = fbm(noise_coords + vec2(0.0, 43.1)) - 0.5;

                vec3 warped = coords_geo;
                float warp_px = 96.0;
                warped.x += wx * warp_px / size_geo.x * p;
                warped.y += wy * warp_px / size_geo.y * p;

                vec3 tex_coords = niri_geo_to_tex * warped;
                vec4 color = texture2D(niri_tex, tex_coords.st);

                float alpha = edge_alpha * (1.0 - p * p);
                alpha = clamp(alpha, 0.0, 1.0);

                float glow_softness = min_dim * 0.04;
                float glow = smoothstep(edge_threshold - glow_softness, edge_threshold, edge_dist) * (1.0 - smoothstep(edge_threshold, edge_threshold + glow_softness, edge_dist));
                glow *= p * 0.6; 
                color.rgb += vec3(0.3, 0.18, 0.06) * glow;

                vec4 effect_color = color * alpha;
                
                vec3 raw_tex_coords = niri_geo_to_tex * coords_geo;
                vec4 raw_color = texture2D(niri_tex, raw_tex_coords.st);

                float fade_to_raw = smoothstep(0.0, 0.1, p);
                return mix(raw_color, effect_color, fade_to_raw);
            }
        "
    }

    window-close {
        duration-ms 700
        curve "ease-out-quad"
        custom-shader r"
            float hash21(vec2 p) {
                return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
            }

            float value_noise(vec2 p) {
                vec2 i = floor(p);
                vec2 f = fract(p);
                vec2 u = f * f * (3.0 - 2.0 * f);
                return mix(
                    mix(hash21(i), hash21(i + vec2(1.0, 0.0)), u.x),
                    mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), u.x),
                    u.y
                );
            }

            float fbm(vec2 p) {
                float v = 0.0;
                float amp = 0.5;
                float freq = 1.0;
                for (int i = 0; i < 5; i++) {
                    v += amp * value_noise(p * freq);
                    freq *= 2.0;
                    amp *= 0.5;
                }
                return v;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = coords_geo.xy;
                float p = niri_clamped_progress;
                float seed = niri_random_seed * 100.0;
                float min_dim = min(size_geo.x, size_geo.y);

                float dx = min(uv.x, 1.0 - uv.x) * size_geo.x;
                float dy = min(uv.y, 1.0 - uv.y) * size_geo.y;
                float edge_dist = min(dx, dy);

                // Use absolute pixel dimensions to keep noise visually identical on all window sizes
                vec2 noise_coords = uv * size_geo.xy / 150.0 + seed;
                float edge_noise = fbm(noise_coords * 1.5);
                float erode = p * 0.80;
                float edge_threshold = edge_noise * erode * min_dim;
                float edge_softness = min_dim * 0.02;
                float edge_alpha = smoothstep(edge_threshold - edge_softness, edge_threshold + edge_softness, edge_dist);

                if (edge_dist < -min_dim * 0.15) {
                    return vec4(0.0);
                }

                float wx = fbm(noise_coords + vec2(17.3, 0.0)) - 0.5;
                float wy = fbm(noise_coords + vec2(0.0, 43.1)) - 0.5;

                vec3 warped = coords_geo;
                float warp_px = 96.0;
                warped.x += wx * warp_px / size_geo.x * p;
                warped.y += wy * warp_px / size_geo.y * p;

                vec3 tex_coords = niri_geo_to_tex * warped;
                vec4 color = texture2D(niri_tex, tex_coords.st);

                float alpha = edge_alpha * (1.0 - p * p);
                alpha = clamp(alpha, 0.0, 1.0);

                float glow_softness = min_dim * 0.04;
                float glow = smoothstep(edge_threshold - glow_softness, edge_threshold, edge_dist) * (1.0 - smoothstep(edge_threshold, edge_threshold + glow_softness, edge_dist));
                glow *= (1.0 - p) * 0.6;
                color.rgb += vec3(0.3, 0.18, 0.06) * glow;

                return color * alpha;
            }
        "
    }
}