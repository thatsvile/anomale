animations {
    window-open {
        duration-ms 500
        curve "linear"
        custom-shader r"
            float spring_to_one(float t, float omega, float zeta) {
                float wd = omega * sqrt(max(1.0 - zeta * zeta, 0.01));
                float envelope = exp(-zeta * omega * t);
                return 1.0 - envelope * (cos(wd * t) + (zeta * omega / wd) * sin(wd * t));
            }

            vec4 sample_scaled(vec2 uv, vec3 coords_geo, float scale) {
                vec2 sample_uv = (uv - 0.5) / max(scale, 0.001) + 0.5;
                if (sample_uv.x < 0.0 || sample_uv.x > 1.0 || sample_uv.y < 0.0 || sample_uv.y > 1.0) {
                    return vec4(0.0);
                }
                vec3 tex_coords = niri_geo_to_tex * vec3(sample_uv, coords_geo.z);
                return texture2D(niri_tex, tex_coords.st);
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = coords_geo.xy;
                float t = niri_clamped_progress;
                float min_dim = min(size_geo.x, size_geo.y);

                float dx = min(uv.x, 1.0 - uv.x) * size_geo.x;
                float dy = min(uv.y, 1.0 - uv.y) * size_geo.y;
                if (min(dx, dy) < -min_dim * 0.15) {
                    return vec4(0.0);
                }

                float scale = spring_to_one(t, 13.0, 0.36);
                if (t > 0.82) {
                    scale = mix(scale, 1.0, smoothstep(0.82, 1.0, t));
                }
                return sample_scaled(uv, coords_geo, scale);
            }
        "
    }

    window-close {
        duration-ms 700
        curve "linear"
        custom-shader r"
            float spring_to_one(float t, float omega, float zeta) {
                float wd = omega * sqrt(max(1.0 - zeta * zeta, 0.01));
                float envelope = exp(-zeta * omega * t);
                return 1.0 - envelope * (cos(wd * t) + (zeta * omega / wd) * sin(wd * t));
            }

            vec4 sample_scaled(vec2 uv, vec3 coords_geo, float scale) {
                vec2 sample_uv = (uv - 0.5) / max(scale, 0.001) + 0.5;
                if (sample_uv.x < 0.0 || sample_uv.x > 1.0 || sample_uv.y < 0.0 || sample_uv.y > 1.0) {
                    return vec4(0.0);
                }
                vec3 tex_coords = niri_geo_to_tex * vec3(sample_uv, coords_geo.z);
                return texture2D(niri_tex, tex_coords.st);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                vec2 uv = coords_geo.xy;
                float t = niri_clamped_progress;
                float min_dim = min(size_geo.x, size_geo.y);

                float dx = min(uv.x, 1.0 - uv.x) * size_geo.x;
                float dy = min(uv.y, 1.0 - uv.y) * size_geo.y;
                if (min(dx, dy) < -min_dim * 0.15) {
                    return vec4(0.0);
                }

                float shrink = spring_to_one(t, 9.0, 0.62);
                float scale = max(1.0 - shrink, 0.0);
                vec4 color = sample_scaled(uv, coords_geo, scale);

                float alpha = smoothstep(0.0, 0.06, scale);
                return color * alpha;
            }
        "
    }
}
