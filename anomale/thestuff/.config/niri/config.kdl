// Niri config matched to ~/.config/mango/config.conf + anomale integration

include "animations/pixel-waves.kdl"

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 600
        repeat-rate 25
        numlock
    }

    touchpad {
        tap
        dwt
        drag true
        drag-lock
        natural-scroll
    }

    mouse {
        // mouse_natural_scrolling=0 in mango
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="10%"
    mod-key "Super"
}

/-output "DP-1" {
    mode "2560x1440@165"
    scale 1
    transform "normal"
    position x=0 y=233
}

/-output "HDMI-A-1" {
    mode "1280x800@60"
    scale 1
    transform "normal"
    position x=600 y=1673
}

layout {
    gaps 10
    center-focused-column "on-overflow"
    always-center-single-column

    preset-column-widths {
        proportion 0.5
        proportion 0.8
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
        width 2
    }

    border {
        on
        width 2
    }

    shadow {
        on
        softness 1
        spread 0
        offset x=4 y=4
    }

    struts {
        left 10
        right 10
    }
}

blur {
    passes 3
    offset 3
    noise 0
    saturation 1
}

overview {
    zoom 0.5
}

cursor {
    xcursor-size 24
}

spawn-sh-at-startup "~/.local/bin/niri-start.sh"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

layer-rule {
    match namespace="^anomale-notification$"
    match layer="overlay"

    shadow {
        on
        softness 1
        spread 0
        offset x=4 y=4
    }
    geometry-corner-radius 16

    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^anomale-bar$"
    shadow {
        on
        softness 1
        spread 0
        offset x=4 y=4
    }
    geometry-corner-radius 16
    background-effect {
        blur false
        xray false
    }
}

window-rule {
    match app-id="network"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 612; }
}

window-rule {
    match app-id="btop"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="audio"
    open-floating true
    default-column-width { fixed 760; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="matrix"
    open-fullscreen true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// anomale menu popups (toplevel floating windows)
window-rule {
    match app-id="^com.jor.anomale$" title="^Anomale Launcher$"
    open-floating true
    open-focused true
    draw-border-with-background false
    default-floating-position x=0 y=200 relative-to="top"
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="^com.jor.anomale$" title="^Anomale (Power Menu|System Tray|Wallpaper Selector|.+ Menu)$"
    open-floating true
    open-focused true
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false
    background-effect {
        blur true
        xray true
    }
}

binds {
    // reload / anomale
    Mod+R repeat=false { spawn "anomale" "--refreshexec"; }
    Mod+Shift+R repeat=false { spawn "anomale" "--reload"; }

    // menu and terminal
    Mod+Tab { spawn "foot"; }
    Alt+Space { spawn "anomale" "--apps"; }
    Mod+Space { spawn "anomale" "--power"; }
    Mod+Shift+L { spawn "anomale" "--wallpapers"; }
    Mod+Shift+T { spawn "anomale" "--tray"; }

    // terminal widgets
    Mod+Shift+W { spawn-sh "foot -a network sh -c wifitui"; }
    Mod+Shift+B { spawn-sh "foot -a btop -e btop"; }
    Mod+Shift+S { spawn-sh "foot -a audio -e pulsemixer"; }
    Mod+Shift+0 { spawn-sh "foot -a matrix sh -c 'sleep 0.1 && cmatrix'"; }

    // screenshots / recording
    Mod+Shift+P { spawn "mangoshooter" "monitor"; }
    Mod+Shift+O { spawn "mangoshooter" "area"; }
    Mod+Shift+I { spawn "mangorecorder" "-sec" "5"; }

    // audio / brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }

    // exit
    Mod+Q repeat=false { close-window; }

    // switch window focus (mango: ALT + arrows)
    Alt+Left { focus-column-left; }
    Alt+Right { focus-column-right; }
    Alt+Up { focus-window-up; }
    Alt+Down { focus-window-down; }

    // swap window (mango: SUPER+SHIFT + arrows)
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // switch window status
    Alt+Tab repeat=false { toggle-overview; }
    Mod+A { toggle-window-floating; }
    Alt+A { maximize-window-to-edges; }
    Alt+F { fullscreen-window; }
    Alt+Shift+F { toggle-windowed-fullscreen; }
    Mod+B { maximize-column; }

    // scroller layout
    Alt+E { set-column-width "100%"; }
    Alt+X { switch-preset-column-width; }
    Alt+Shift+Right { consume-or-expel-window-right; }
    Alt+Shift+Left { consume-or-expel-window-left; }

    // tag / workspace switch
    Mod+Left { focus-workspace-up; }
    Ctrl+Left { focus-workspace-up; }
    Mod+Right { focus-workspace-down; }
    Ctrl+Right { focus-workspace-down; }
    Ctrl+Mod+Left { move-workspace-up; }
    Ctrl+Mod+Right { move-workspace-down; }

    // monitor switch (mango: SUPER+Alt)
    Mod+Alt+Left { move-workspace-to-monitor-left; }
    Mod+Alt+Right { move-workspace-to-monitor-right; }

    // move floating window
    Ctrl+Shift+Up { spawn "niri" "msg" "action" "move-floating-window" "--y" "-50"; }
    Ctrl+Shift+Down { spawn "niri" "msg" "action" "move-floating-window" "--y" "+50"; }
    Ctrl+Shift+Left { spawn "niri" "msg" "action" "move-floating-window" "--x" "-50"; }
    Ctrl+Shift+Right { spawn "niri" "msg" "action" "move-floating-window" "--x" "+50"; }

    // resize floating window
    Ctrl+Alt+Up { spawn "niri" "msg" "action" "set-window-height" "-50"; }
    Ctrl+Alt+Down { spawn "niri" "msg" "action" "set-window-height" "+50"; }
    Ctrl+Alt+Left { spawn "niri" "msg" "action" "set-window-width" "-50"; }
    Ctrl+Alt+Right { spawn "niri" "msg" "action" "set-window-width" "+50"; }

    // mouse
    Mod+MouseMiddle { maximize-column; }

    // axis bindings (mango: SUPER + scroll)
    Mod+WheelScrollUp cooldown-ms=100 { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=100 { focus-workspace-down; }

    // escape hatch for shortcut inhibitors
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

include optional=true "~/.cache/wal/niri-colors.kdl"
